# ============================================
# AsanYaz Environment Configuration
# ============================================

# Database
DATABASE_URL=postgresql://asanyaz:asanyaz@localhost:5432/asanyaz
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=asanyaz
DATABASE_USER=asanyaz
DATABASE_PASSWORD=asanyaz

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=7d

# AI Provider
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=8000

# Storage (S3-compatible / Cloudflare R2)
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=asanyaz-files
R2_REGION=auto

# Payment
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
PAYMENT_PROVIDER=stripe

# Email
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@asanyaz.com
EMAIL_PROVIDER=resend

# App
APP_URL=http://localhost:4321
API_URL=http://localhost:3000
WORKER_CONCURRENCY=3

# Document Service
DOCUMENT_SERVICE_URL=http://localhost:8000

# Admin
ADMIN_EMAIL=admin@asanyaz.com
ADMIN_PASSWORD=change-this-in-production
