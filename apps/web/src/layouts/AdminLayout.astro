---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="az">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin AsanYaz</title>
  </head>
  <body class="min-h-screen bg-gray-100 flex flex-col md:flex-row">
    
    <aside class="w-full md:w-64 bg-gray-900 text-white flex-shrink-0 md:h-screen md:sticky top-0 flex flex-col hidden md:flex">
      <div class="h-16 flex items-center px-6 border-b border-gray-800">
        <span class="text-xl font-bold">AsanYaz Admin</span>
      </div>
      
      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a href="/admin" class="flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 hover:text-white transition-colors text-gray-300">
          Dashboard
        </a>
        <a href="/admin/orders" class="flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 hover:text-white transition-colors text-gray-300">
          Sifarişlər
        </a>
        <a href="#" class="flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 hover:text-white transition-colors text-gray-300">
          İstifadəçilər (Tezliklə)
        </a>
        <a href="#" class="flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 hover:text-white transition-colors text-gray-300">
          Xidmətlər (Tezliklə)
        </a>
        <a href="#" class="flex items-center px-2 py-2 text-sm font-medium rounded-md hover:bg-gray-800 hover:text-white transition-colors text-gray-300">
          Universitetlər (Tezliklə)
        </a>
      </nav>
      
      <div class="p-4 border-t border-gray-800">
        <button id="admin-logout-btn" class="w-full text-left px-2 py-2 text-sm font-medium text-gray-400 hover:text-white transition-colors">
          Çıxış
        </button>
      </div>
    </aside>

    {/* Mobile Header */}
    <header class="md:hidden bg-gray-900 text-white h-16 flex items-center justify-between px-4 sticky top-0 z-20">
      <span class="text-xl font-bold">AsanYaz Admin</span>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
      <slot />
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const token = localStorage.getItem('asanyaz_admin_token');
        if (!token) {
          window.location.href = '/admin/login';
        }

        document.getElementById('admin-logout-btn')?.addEventListener('click', () => {
          localStorage.removeItem('asanyaz_admin_token');
          window.location.href = '/admin/login';
        });
      });
    </script>
  </body>
</html>
