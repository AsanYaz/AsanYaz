---
import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Sifarişin detalı">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center">
      <a href="/dashboard/orders" class="mr-4 text-gray-400 hover:text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
      </a>
      <h1 class="text-2xl font-bold text-gray-900">Sifariş <span id="order-number" class="text-primary-500">...</span></h1>
    </div>
    <div id="status-badge-container"></div>
  </div>

  <div id="loading-spinner" class="flex justify-center items-center py-20">
    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500"></div>
  </div>

  <div id="error-container" class="hidden rounded-md bg-red-50 p-4 mb-6">
    <div class="flex">
      <div class="ml-3">
        <h3 class="text-sm font-medium text-red-800" id="error-text"></h3>
      </div>
    </div>
  </div>

  <div id="content-container" class="hidden">
    
    {/* Files Section (shown if completed) */}
    <div id="files-section" class="hidden mb-8">
      <div class="bg-gradient-to-r from-primary-500 to-primary-600 rounded-xl shadow-md overflow-hidden text-white p-8 text-center">
        <div class="mx-auto w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-2xl font-bold mb-2">İşiniz hazırdır!</h2>
        <p class="text-primary-100 mb-8 max-w-lg mx-auto">Sənədiniz universitetinizin tələblərinə uyğun olaraq hazırlanıb və formatlanıb.</p>
        
        <div id="download-buttons" class="flex flex-wrap justify-center gap-4">
          {/* Buttons inserted via JS */}
        </div>
      </div>
    </div>

    {/* Progress Tracker (shown if processing) */}
    <div id="progress-section" class="hidden mb-8 bg-white shadow-soft rounded-xl border border-gray-100 p-6">
      <h3 class="text-lg font-bold text-gray-900 mb-6">Sifarişin gedişatı</h3>
      <div class="relative">
        <div class="overflow-hidden h-2 mb-4 text-xs flex rounded bg-primary-100">
          <div id="progress-bar" style="width: 0%" class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-primary-500 transition-all duration-500"></div>
        </div>
        <p id="progress-text" class="text-sm text-gray-600 text-center font-medium animate-pulse">Sistem hazırlanır...</p>
      </div>
    </div>
    
    {/* Payment reminder (shown if awaiting payment) */}
    <div id="payment-section" class="hidden mb-8 bg-yellow-50 border border-yellow-200 rounded-xl p-6 flex flex-col sm:flex-row items-center justify-between">
      <div>
        <h3 class="text-lg font-bold text-yellow-800">Ödəniş gözlənilir</h3>
        <p class="text-yellow-700 mt-1">Sifarişin icrasına başlamaq üçün ödənişi tamamlayın.</p>
      </div>
      <button id="pay-now-btn" class="mt-4 sm:mt-0 bg-yellow-500 hover:bg-yellow-600 text-white px-6 py-2 rounded-lg font-medium shadow-sm transition-colors">
        İndi ödə (<span id="pay-amount"></span> AZN)
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2 space-y-6">
        <div class="bg-white shadow-soft rounded-xl border border-gray-100 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-900">Sifariş detalları</h3>
          </div>
          <div class="p-6">
            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-6">
              <div class="sm:col-span-2">
                <dt class="text-sm font-medium text-gray-500">Mövzu</dt>
                <dd class="mt-1 text-base text-gray-900 font-medium" id="detail-topic"></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Xidmət</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-service"></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Universitet</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-uni"></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Tələbə</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-student"></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Müəllim / Elmi rəhbər</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-instructor">-</dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Həcm</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-length">-</dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Dil</dt>
                <dd class="mt-1 text-sm text-gray-900" id="detail-language"></dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-sm font-medium text-gray-500">Əlavə qeydlər</dt>
                <dd class="mt-1 text-sm text-gray-900 bg-gray-50 p-3 rounded border border-gray-100" id="detail-notes">-</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
      
      <div>
        <div class="bg-white shadow-soft rounded-xl border border-gray-100 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-900">Məlumat</h3>
          </div>
          <div class="p-6">
            <dl class="space-y-4">
              <div>
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tarix</dt>
                <dd class="mt-1 text-sm text-gray-900" id="info-date"></dd>
              </div>
              <div class="pt-4 border-t border-gray-100">
                <dt class="text-xs font-medium text-gray-500 uppercase tracking-wider">Məbləğ</dt>
                <dd class="mt-1 text-lg font-bold text-primary-600" id="info-price"></dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import axios from 'axios';

  document.addEventListener('DOMContentLoaded', async () => {
    // Get ID from URL path (e.g. /dashboard/orders/123)
    const pathParts = window.location.pathname.split('/');
    const orderId = pathParts[pathParts.length - 1];
    
    if (!orderId) {
      showError('Sifariş ID tapılmadı');
      return;
    }

    const token = localStorage.getItem('asanyaz_token');
    const api = axios.create({
      baseURL: 'http://localhost:3000/api',
      headers: { Authorization: `Bearer ${token}` }
    });

    try {
      // Load order data
      const res = await api.get(`/orders/${orderId}`);
      if (!res.data.success) {
        showError(res.data.error || 'Sifariş tapılmadı');
        return;
      }
      
      const order = res.data.data;
      
      // Update UI
      document.getElementById('loading-spinner')!.classList.add('hidden');
      document.getElementById('content-container')!.classList.remove('hidden');
      
      document.getElementById('order-number')!.textContent = order.order_number;
      document.getElementById('status-badge-container')!.innerHTML = getStatusLabel(order.status);
      
      // Details
      document.getElementById('detail-topic')!.textContent = order.topic;
      document.getElementById('detail-service')!.textContent = order.service_name;
      
      let uniText = order.university_name;
      if (order.faculty_name) uniText += ` • ${order.faculty_name}`;
      if (order.department_name) uniText += ` • ${order.department_name}`;
      document.getElementById('detail-uni')!.textContent = uniText;
      
      document.getElementById('detail-student')!.textContent = order.student_name;
      if (order.instructor_name) document.getElementById('detail-instructor')!.textContent = order.instructor_name;
      
      if (order.requested_length) document.getElementById('detail-length')!.textContent = `~${order.requested_length} səhifə`;
      
      const langs: Record<string, string> = { 'az': 'Azərbaycan', 'en': 'İngilis', 'ru': 'Rus' };
      document.getElementById('detail-language')!.textContent = langs[order.language] || order.language;
      
      if (order.additional_requirements) document.getElementById('detail-notes')!.textContent = order.additional_requirements;
      
      document.getElementById('info-date')!.textContent = new Date(order.created_at).toLocaleString('az-AZ');
      document.getElementById('info-price')!.textContent = `${order.price} AZN`;

      // Handle specific statuses
      if (order.status === 'awaiting_payment') {
        document.getElementById('payment-section')!.classList.remove('hidden');
        document.getElementById('pay-amount')!.textContent = order.price;
        
        document.getElementById('pay-now-btn')?.addEventListener('click', async () => {
          try {
            const payRes = await api.post('/payments/create', { orderId });
            // Simulate successful payment (MVP)
            await api.post(`/payments/confirm/${payRes.data.data.paymentId}`);
            window.location.reload();
          } catch (e: any) {
            alert('Ödəniş xətası: ' + (e.response?.data?.message || e.message));
          }
        });
      } 
      else if (order.status === 'completed') {
        document.getElementById('files-section')!.classList.remove('hidden');
        loadFiles(api, orderId);
      }
      else if (!['draft', 'cancelled', 'refunded', 'failed'].includes(order.status)) {
        // Show progress for active processing states
        document.getElementById('progress-section')!.classList.remove('hidden');
        updateProgressUI(order.status);
        
        // Auto-refresh logic (basic polling)
        setTimeout(() => window.location.reload(), 15000);
      }

    } catch (e: any) {
      console.error(e);
      showError(e.response?.data?.message || 'Məlumatları yükləmək mümkün olmadı');
    }
  });

  function showError(msg: string) {
    document.getElementById('loading-spinner')?.classList.add('hidden');
    document.getElementById('error-container')?.classList.remove('hidden');
    const errText = document.getElementById('error-text');
    if (errText) errText.textContent = msg;
  }

  function getStatusLabel(status: string) {
    const labels: Record<string, {text: string, class: string}> = {
      'draft': {text: 'Qaralama', class: 'bg-gray-100 text-gray-800'},
      'awaiting_payment': {text: 'Ödəniş gözlənilir', class: 'bg-yellow-100 text-yellow-800 ring-1 ring-yellow-600/20'},
      'paid': {text: 'Ödəniş edildi', class: 'bg-blue-100 text-blue-800 ring-1 ring-blue-600/20'},
      'queued': {text: 'Növbədə', class: 'bg-gray-100 text-gray-800 ring-1 ring-gray-600/20'},
      'researching': {text: 'Materiallar hazırlanır', class: 'bg-purple-100 text-purple-800 ring-1 ring-purple-600/20'},
      'generating': {text: 'Sənəd yaradılır', class: 'bg-indigo-100 text-indigo-800 ring-1 ring-indigo-600/20'},
      'formatting': {text: 'Formatlaşdırılır', class: 'bg-pink-100 text-pink-800 ring-1 ring-pink-600/20'},
      'quality_check': {text: 'Yoxlanılır', class: 'bg-orange-100 text-orange-800 ring-1 ring-orange-600/20'},
      'completed': {text: 'Tamamlandı', class: 'bg-green-100 text-green-800 ring-1 ring-green-600/20'},
      'failed': {text: 'Xəta', class: 'bg-red-100 text-red-800 ring-1 ring-red-600/20'},
      'cancelled': {text: 'Ləğv edildi', class: 'bg-red-100 text-red-800 ring-1 ring-red-600/20'},
    };
    const found = labels[status] || {text: status, class: 'bg-gray-100 text-gray-800'};
    return `<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${found.class}">${found.text}</span>`;
  }

  function updateProgressUI(status: string) {
    const progressMap: Record<string, {pct: string, txt: string}> = {
      'paid': { pct: '10%', txt: 'Ödəniş təsdiqləndi, sistemə ötürülür...' },
      'queued': { pct: '20%', txt: 'Sifariş qəbul edildi, növbəyə alındı...' },
      'researching': { pct: '40%', txt: 'Elmi materiallar və mənbələr araşdırılır...' },
      'generating': { pct: '60%', txt: 'Sənədin əsas məzmunu generatsiya edilir...' },
      'formatting': { pct: '80%', txt: 'Universitet standartlarına uyğun formatlanır...' },
      'quality_check': { pct: '90%', txt: 'Sənəd yoxlanılır və son toxunuşlar edilir...' },
    };
    
    const info = progressMap[status] || { pct: '50%', txt: 'İşlənir...' };
    
    document.getElementById('progress-bar')!.style.width = info.pct;
    document.getElementById('progress-text')!.textContent = info.txt;
  }

  async function loadFiles(api: any, orderId: string) {
    try {
      const res = await api.get(`/orders/${orderId}/files`);
      const files = res.data.data;
      
      const container = document.getElementById('download-buttons');
      if (!container) return;
      
      if (files && files.length > 0) {
        container.innerHTML = files.map((f: any) => {
          // For MVP, we simulate download since actual S3 isn't set up
          const label = f.file_type.toUpperCase() + ' Yüklə';
          const icon = f.file_type === 'pdf' 
            ? `<svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`
            : `<svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`;
            
          return `
            <button onclick="alert('Fayl yüklənir: ${f.file_name}')" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-primary-600 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white shadow-sm transition-colors">
              ${icon} ${label}
            </button>
          `;
        }).join('');
      } else {
        container.innerHTML = '<p class="text-white">Fayllar tapılmadı</p>';
      }
    } catch (e) {
      console.error('Fayllar yüklənərkən xəta:', e);
    }
  }
</script>
