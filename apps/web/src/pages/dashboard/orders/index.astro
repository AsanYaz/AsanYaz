---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Sifarişlərim">
  <div class="flex justify-between items-end mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Sifarişlərim</h1>
      <p class="text-gray-500 mt-1">Bütün sifarişlərinizin siyahısı və statusları.</p>
    </div>
    <div>
      <a href="/dashboard/new-order" class="btn-primary py-2 px-4 shadow-sm text-sm">
        + Yeni sifariş
      </a>
    </div>
  </div>

  <div class="bg-white shadow-soft rounded-xl border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sifariş / Tarix</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Mövzu / Xidmət</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Qiymət</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th scope="col" class="relative px-6 py-3"><span class="sr-only">Hərəkətlər</span></th>
          </tr>
        </thead>
        <tbody id="orders-table-body" class="bg-white divide-y divide-gray-200">
          <tr>
            <td colspan="5" class="px-6 py-12 text-center">
              <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary-500"></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div id="pagination-container" class="bg-white px-4 py-3 border-t border-gray-200 flex items-center justify-between sm:px-6 hidden">
      <div class="flex-1 flex justify-between sm:hidden">
        <button id="prev-btn-mobile" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Əvvəlki</button>
        <button id="next-btn-mobile" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Növbəti</button>
      </div>
      <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
        <div>
          <p class="text-sm text-gray-700">
            Göstərilir <span id="page-start" class="font-medium">1</span> - <span id="page-end" class="font-medium">10</span> (Cəmi: <span id="page-total" class="font-medium">20</span>)
          </p>
        </div>
        <div>
          <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
            <button id="prev-btn" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
              <span class="sr-only">Əvvəlki</span>
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
            <span id="current-page-display" class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
              1
            </span>
            <button id="next-btn" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
              <span class="sr-only">Növbəti</span>
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
          </nav>
        </div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import axios from 'axios';

  document.addEventListener('DOMContentLoaded', () => {
    const token = localStorage.getItem('asanyaz_token');
    const api = axios.create({
      baseURL: 'http://localhost:3000/api',
      headers: { Authorization: `Bearer ${token}` }
    });
    
    let currentPage = 1;
    let totalPages = 1;

    const getStatusLabel = (status: string) => {
      const labels: Record<string, {text: string, class: string}> = {
        'draft': {text: 'Qaralama', class: 'bg-gray-100 text-gray-800'},
        'awaiting_payment': {text: 'Ödəniş gözlənilir', class: 'bg-yellow-100 text-yellow-800'},
        'paid': {text: 'Ödəniş edildi', class: 'bg-blue-100 text-blue-800'},
        'queued': {text: 'Sifariş qəbul edildi', class: 'bg-gray-100 text-gray-800'},
        'researching': {text: 'Materiallar hazırlanır', class: 'bg-purple-100 text-purple-800'},
        'generating': {text: 'Sənəd yaradılır', class: 'bg-indigo-100 text-indigo-800'},
        'formatting': {text: 'Formatlaşdırılır', class: 'bg-pink-100 text-pink-800'},
        'quality_check': {text: 'Yoxlanılır', class: 'bg-orange-100 text-orange-800'},
        'completed': {text: 'Tamamlandı', class: 'bg-green-100 text-green-800'},
        'failed': {text: 'Xəta', class: 'bg-red-100 text-red-800'},
        'cancelled': {text: 'Ləğv edildi', class: 'bg-red-100 text-red-800'},
        'refunded': {text: 'Geri qaytarıldı', class: 'bg-gray-100 text-gray-800'},
      };
      const found = labels[status] || {text: status, class: 'bg-gray-100 text-gray-800'};
      return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${found.class}">${found.text}</span>`;
    };

    const formatDate = (dateStr: string) => {
      return new Date(dateStr).toLocaleString('az-AZ', { 
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute:'2-digit'
      });
    };

    const loadOrders = async (page: number) => {
      const tbody = document.getElementById('orders-table-body');
      if (!tbody) return;

      try {
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center"><div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-primary-500"></div></td></tr>`;
        
        const res = await api.get(`/orders?page=${page}&limit=10`);
        const { data, total, limit, totalPages: tp } = res.data;
        
        totalPages = tp;
        currentPage = page;
        
        if (data.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                Sifariş tapılmadı.
              </td>
            </tr>
          `;
          document.getElementById('pagination-container')?.classList.add('hidden');
          return;
        }

        tbody.innerHTML = data.map((order: any) => `
          <tr class="hover:bg-gray-50 transition-colors cursor-pointer" onclick="window.location.href='/dashboard/orders/${order.id}'">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">${order.order_number}</div>
              <div class="text-xs text-gray-500">${formatDate(order.created_at)}</div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900 font-medium truncate max-w-xs" title="${order.topic}">${order.topic}</div>
              <div class="text-xs text-gray-500 truncate max-w-xs">${order.service_name} • ${order.university_name}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">
              ${order.price} AZN
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ${getStatusLabel(order.status)}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <a href="/dashboard/orders/${order.id}" class="text-primary-600 hover:text-primary-900" onclick="event.stopPropagation()">Bax</a>
            </td>
          </tr>
        `).join('');

        // Update pagination UI
        const pagContainer = document.getElementById('pagination-container');
        if (pagContainer && total > 0) {
          pagContainer.classList.remove('hidden');
          
          const start = (page - 1) * limit + 1;
          const end = Math.min(start + limit - 1, total);
          
          document.getElementById('page-start')!.textContent = start.toString();
          document.getElementById('page-end')!.textContent = end.toString();
          document.getElementById('page-total')!.textContent = total.toString();
          document.getElementById('current-page-display')!.textContent = page.toString();
          
          // Disable/Enable buttons
          const prevBtns = [document.getElementById('prev-btn'), document.getElementById('prev-btn-mobile')];
          const nextBtns = [document.getElementById('next-btn'), document.getElementById('next-btn-mobile')];
          
          prevBtns.forEach(b => {
            if (b) {
              if (page <= 1) { b.setAttribute('disabled', 'true'); b.classList.add('opacity-50', 'cursor-not-allowed'); }
              else { b.removeAttribute('disabled'); b.classList.remove('opacity-50', 'cursor-not-allowed'); }
            }
          });
          
          nextBtns.forEach(b => {
            if (b) {
              if (page >= totalPages) { b.setAttribute('disabled', 'true'); b.classList.add('opacity-50', 'cursor-not-allowed'); }
              else { b.removeAttribute('disabled'); b.classList.remove('opacity-50', 'cursor-not-allowed'); }
            }
          });
        }
      } catch (error) {
        console.error(error);
        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center text-red-500">Məlumatları yükləmək mümkün olmadı.</td></tr>`;
      }
    };

    // Event listeners
    ['prev-btn', 'prev-btn-mobile'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        if (currentPage > 1) loadOrders(currentPage - 1);
      });
    });

    ['next-btn', 'next-btn-mobile'].forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        if (currentPage < totalPages) loadOrders(currentPage + 1);
      });
    });

    // Initial load
    loadOrders(1);
  });
</script>
