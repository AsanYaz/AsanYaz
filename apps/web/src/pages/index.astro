---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ana səhifə">
  {/* Hero Section */}
  <section class="relative bg-white overflow-hidden py-16 sm:py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl tracking-tight font-extrabold text-gray-900 sm:text-5xl md:text-6xl mb-6">
          <span class="block">AsanYaz</span>
          <span class="block text-primary-500">Akademik işlərin daha asan.</span>
        </h1>
        <p class="mt-3 text-base text-gray-500 sm:text-lg md:text-xl md:mt-5 mb-10">
          Sərbəst iş, kurs işi, laboratoriya işi, təqdimat və digər akademik sənədləri asanlıqla sifariş edin. Universitetinizin standartlarına tam uyğun.
        </p>
        <div class="flex justify-center gap-4 flex-col sm:flex-row">
          <a href="/register" class="btn-primary text-lg px-8 py-4">Yeni sifariş</a>
          <a href="#services" class="btn-secondary text-lg px-8 py-4">Xidmətlərə bax</a>
        </div>
      </div>
    </div>
    
    {/* Decorative background element */}
    <div class="absolute inset-y-0 w-full h-full bg-gradient-to-b from-primary-50 to-white -z-10 pointer-events-none"></div>
  </section>

  {/* Services Section */}
  <section id="services" class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Xidmətlər və Qiymətlər</h2>
        <p class="mt-4 text-lg text-gray-500">Sabit qiymətlər. Gizli ödəniş yoxdur.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {/* Service Cards */}
        {[
          { name: 'Sərbəst iş', price: '2 AZN', desc: 'Universitet tələblərinə uyğun sərbəst iş' },
          { name: 'Sərbəst iş + təqdimat', price: '5 AZN', desc: 'Sərbəst iş və PowerPoint təqdimat' },
          { name: 'Uzun təqdimat', price: '10 AZN', desc: 'Ətraflı, geniş və dizaynlı PowerPoint' },
          { name: 'Kurs işi', price: '20 AZN', desc: 'Tam strukturlaşdırılmış kurs işi' },
          { name: 'Laboratoriya işi', price: '20 AZN', desc: 'Laboratoriya hesabatı və nəticələri' },
          { name: 'Diplom işi', price: '150 AZN', desc: 'Bakalavr dərəcəsi üçün tam diplom işi', premium: true },
          { name: 'Magistr dissertasiyası', price: '200 AZN', desc: 'Magistratura üçün elmi dissertasiya', premium: true },
          { name: 'Doktorantura işi', price: '300 AZN', desc: 'Peşəkar elmi tədqiqat işi', premium: true }
        ].map((service) => (
          <div class={`card p-6 flex flex-col justify-between transition-transform duration-300 hover:-translate-y-1 ${service.premium ? 'border-primary-200 shadow-md relative overflow-hidden' : ''}`}>
            {service.premium && <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-primary-400 to-primary-600"></div>}
            <div>
              <h3 class="text-lg font-bold text-gray-900 mb-2">{service.name}</h3>
              <p class="text-sm text-gray-500 mb-6">{service.desc}</p>
            </div>
            <div>
              <div class="text-3xl font-extrabold text-primary-500 mb-4">{service.price}</div>
              <a href="/register" class="block w-full text-center bg-gray-50 hover:bg-gray-100 text-gray-900 font-medium py-2 rounded-lg border border-gray-200 transition-colors">
                Sifariş et
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* How it works */}
  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-extrabold text-gray-900">Necə işləyir?</h2>
        <p class="mt-4 text-lg text-gray-500">4 sadə addımda sənədiniz hazırdır</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
        {[
          { num: '01', title: 'Hesab yarat', desc: 'Sistemə daxil olun və məlumatlarınızı yadda saxlayın' },
          { num: '02', title: 'Xidmətini seç', desc: 'Mövzu, universitet və digər tələbləri qeyd edin' },
          { num: '03', title: 'Ödəniş et', desc: 'Sabit və təhlükəsiz ödəniş edin' },
          { num: '04', title: 'Hazır sənədini yüklə', desc: 'Sənədiniz avtomatik hazırlanır və arxivinizə əlavə edilir' }
        ].map((step, i) => (
          <div class="relative">
            {i !== 3 && <div class="hidden md:block absolute top-8 left-1/2 w-full h-0.5 bg-gray-100"></div>}
            <div class="relative z-10 flex flex-col items-center text-center">
              <div class="w-16 h-16 rounded-full bg-primary-50 flex items-center justify-center text-primary-500 font-bold text-xl mb-6 border border-primary-100">
                {step.num}
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-2">{step.title}</h3>
              <p class="text-gray-500">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  {/* CTA */}
  <section class="bg-primary-500 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-6">İndi başlamağa hazırsınız?</h2>
      <p class="text-primary-100 text-lg mb-8 max-w-2xl mx-auto">
        Bütün sənədləriniz etibarlı şəkildə arxivinizdə saxlanılır. İstədiyiniz zaman yükləyə bilərsiniz.
      </p>
      <a href="/register" class="inline-flex justify-center items-center px-8 py-4 border border-transparent text-lg font-medium rounded-lg text-primary-600 bg-white hover:bg-gray-50 shadow-md transition-colors">
        Hesab yarat və sifariş et
      </a>
    </div>
  </section>
</Layout>
