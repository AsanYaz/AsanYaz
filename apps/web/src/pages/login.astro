---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Giriş">
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-xl shadow-soft border border-gray-100">
      <div>
        <h2 class="mt-2 text-center text-3xl font-extrabold text-gray-900">
          Hesabınıza daxil olun
        </h2>
        <p class="mt-2 text-center text-sm text-gray-600">
          və ya
          <a href="/register" class="font-medium text-primary-500 hover:text-primary-600">
            yeni hesab yaradın
          </a>
        </p>
      </div>
      
      <form class="mt-8 space-y-6" action="#" method="POST" id="login-form">
        <div id="error-message" class="hidden rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800" id="error-text">Xəta baş verdi</h3>
            </div>
          </div>
        </div>

        <div class="rounded-md shadow-sm -space-y-px">
          <div class="mb-4">
            <label for="email-address" class="block text-sm font-medium text-gray-700 mb-1">Email adresi</label>
            <input id="email-address" name="email" type="email" autocomplete="email" required class="input-field py-3 px-4 border border-gray-300" placeholder="adiniz@email.com">
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Şifrə</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required class="input-field py-3 px-4 border border-gray-300" placeholder="••••••••">
          </div>
        </div>

        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <input id="remember-me" name="remember-me" type="checkbox" class="h-4 w-4 text-primary-500 focus:ring-primary-500 border-gray-300 rounded">
            <label for="remember-me" class="ml-2 block text-sm text-gray-900">
              Yadda saxla
            </label>
          </div>

          <div class="text-sm">
            <a href="/forgot-password" class="font-medium text-primary-500 hover:text-primary-600">
              Şifrəni unutmusunuz?
            </a>
          </div>
        </div>

        <div>
          <button type="submit" class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary-500 hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors">
            Daxil ol
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  import axios from 'axios';
  
  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (errorMsg) errorMsg.classList.add('hidden');
      
      const formData = new FormData(form);
      const email = formData.get('email');
      const password = formData.get('password');
      
      try {
        const response = await axios.post('http://localhost:3000/api/auth/login', {
          email,
          password
        });
        
        if (response.data && response.data.token) {
          // In a real app, use HttpOnly cookies. For MVP, we'll use localStorage
          localStorage.setItem('asanyaz_token', response.data.token);
          localStorage.setItem('asanyaz_user', JSON.stringify(response.data.user));
          
          window.location.href = '/dashboard';
        }
      } catch (error: any) {
        if (errorMsg && errorText) {
          errorMsg.classList.remove('hidden');
          errorText.textContent = error.response?.data?.message || 'Sistem xətası baş verdi. Yenidən cəhd edin.';
        }
      }
    });
  }
</script>
